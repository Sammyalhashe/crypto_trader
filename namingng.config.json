{
    "script": [
        {"rule": "struct, class", "pattern": "[A-Z][a-zA-Z0-9]*", "name": "PascalCase"},
        {"rule": "function, variable", "pattern": "[a-z][a-zA-Z0-9]*", "name": "camelCase"},
        {"rule": "private-member, protected-member, public-member", "pattern": "d_[a-z][a-zA-Z0-9]*", "name": "d_camelCase"},
        {"rule": "private-member, protected-member, public-member", "pattern": "d_[a-z][a-zA-Z0-9]*_p", "name": "d_camelCase_p", "suffix": "*_p"}
    ]
}
