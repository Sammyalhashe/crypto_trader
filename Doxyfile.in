PROJECT_NAME       = "@PROJECT_NAME@"
PROJECT_BRIEF      = "Cryptocurrency Trading Bot API Documentation"
PROJECT_LOGO       =
OUTPUT_DIRECTORY   = "@DOXYGEN_OUTPUT_DIRECTORY@"
GENERATE_HTML      = YES
GENERATE_LATEX     = NO
GENERATE_XML       = NO
HTML_OUTPUT        = html
CASE_SENSE_NAMES   = NO
INPUT              = "@PROJECT_SOURCE_DIR@"
FILE_PATTERNS      = *.h *.hpp *.cpp *.t.cpp
RECURSIVE          = YES
EXCLUDE_PATTERNS   = */build/* */.cache/* */cmake.bld/* */zig-out/* */.zig-cache/* */tests/*
EXCLUDE_SYMBOLS    =
EXTRACT_ALL        = YES
EXTRACT_STATIC     = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
HIDE_FRIEND_INFO   = NO
ALPHABETICAL_INDEX = YES
GENERATE_TOC       = YES
GENERATE_TREEVIEW  = YES
HTML_FORMULA_FORMAT = SVG
UML_LOOK           = YES
HAVE_DOT           = YES
DOT_GRAPH_MAX_NODES = 100
DOTFILE_DIRS       = "@CMAKE_BINARY_DIR@"
TAGFILES           =
CLASS_DIAGRAMS     = YES
GENERATE_BUDDY_RELATIONS = YES
GENERATE_LEGEND    = YES
VERBATIM_HEADERS   = NO
